    "hud",
    "shelf-write"
  ],
  "surfaces": [
    "shelf-widget",
    "settings-pane",
    "hud"
  ],
  "icon": "AdbPair.icon",
  "creator": {
    "name": "zer0-deaths",
    "kind": "community",
